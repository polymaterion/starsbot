# ── Telegram ─────────────────────────────────────────────
BOT_TOKEN=123456:CHANGE_ME
BOT_NAME=Stars Bot
# ID админов через запятую (им приходят ЛС-уведомления и доступны команды)
ADMIN_IDS=111111111,222222222
# ID админ-группы (отрицательное число). Бот должен быть в группе.
ADMIN_GROUP_ID=-1001234567890
# Ссылка для кнопки «Поддержка», например https://t.me/your_support
SUPPORT_URL=

# ── База данных ──────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://stars:CHANGE_ME@db:5432/stars

# ── Hex Reseller API ─────────────────────────────────────
HEX_API_KEY=CHANGE_ME
HEX_BASE_URL=https://hexpay.live/api/reseller/v1

# ── Реквизиты для перевода с баланса оператора ──────────
# Несколько номеров через запятую — выдаются по кругу
PAY_NUMBERS=99361000000,99365000000
# Необязательная подпись под номером (оператор, имя получателя)
PAY_NOTE=

# ── Цены ─────────────────────────────────────────────────
# Стартовые значения; дальше меняются командами /rate и /markup
DEFAULT_RATE_TMT_PER_RUB=0.045
DEFAULT_MARKUP_PERCENT=10
# Если Hex подорожал больше чем на N% от проданной цены — ждём решения админа
PRICE_GUARD_PERCENT=3

# ── Лимиты ───────────────────────────────────────────────
PAYMENT_TTL_MINUTES=30
MAX_PROOF_ATTEMPTS=3
STARS_MIN=50
STARS_MAX=100000
TOPUP_MIN_TMT=10
TOPUP_MAX_TMT=2000
# Сколько часов ждать пополнения депозита Hex, потом отмена с возвратом
HEX_WAIT_HOURS=6
# Порог предупреждения о низком депозите Hex (в рублях)
HEX_LOW_BALANCE_RUB=2000
